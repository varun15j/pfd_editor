<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug builds only: the image-loading profiler keeps its database in
         Documents/LumaScan/debug so it survives an uninstall. A reinstalled
         app needs "All files access" (Android 11+) or the storage permission
         (Android 8-10) to open it again. Release builds never ask.
         The camera plugin also declares WRITE_EXTERNAL_STORAGE, capped at
         Android 9; tools:replace keeps this debug-only cap at Android 10. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:replace="android:maxSdkVersion"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <application android:requestLegacyExternalStorage="true"/>
</manifest>
