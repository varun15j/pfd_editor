JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=change-me
JENKINS_URL=http://localhost:8080/
# A GitHub fine-grained token for varun15j/pfd_editor with read access to
# Contents, Pull requests and Metadata, and read/write Commit statuses.
GITHUB_USER=varun15j
GITHUB_TOKEN=
# Host port for the Jenkins UI. Change it if 8080 is taken (e.g. by Apache),
# and update JENKINS_URL to match.
JENKINS_PORT=8080
